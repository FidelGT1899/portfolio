# Variables para Resend
MAILER_TO=example@example.com
MAILER_SECRET_KEY=your_secret_key

# Variables para SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password

# Rate limit del formulario de contacto (opcionales, estos son los valores por defecto)
# CONTACT_RATE_BURST=3
# CONTACT_RATE_BURST_WINDOW_MS=600000
# CONTACT_RATE_DAILY=15
# CONTACT_RATE_DAILY_WINDOW_MS=86400000